# Copy to .env (never commit .env). Every key is optional: without it that feature is a no-op.
# For EAS builds set the same names with `eas env:create` (environment: production / preview / development).

# GA4 (Measurement Protocol, no SDK). GA4 → Admin → Data streams → Web stream → Measurement ID + MP API secret.
EXPO_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
EXPO_PUBLIC_GA4_API_SECRET=

# RevenueCat public SDK keys (Project settings → API keys). Public by design.
EXPO_PUBLIC_RC_IOS_KEY=appl_xxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxx

# Hosted legal pages (required in the paywall and store listings).
EXPO_PUBLIC_PRIVACY_URL=https://capyprayer.com/privacy
EXPO_PUBLIC_TERMS_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
EXPO_PUBLIC_SUPPORT_EMAIL=hello@capyprayer.com

# Optional backend (not used in v1).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
