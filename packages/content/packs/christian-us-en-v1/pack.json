  "lessons": [
    {
      "id": "meet-capy",
      "skillId": "hello",
      "title": "Meet Capy",
      "free": true,
      "routine": "intro",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi {kidName}! I'm Capy. I live in this pond.",
          "audio": "intro_01.mp3",
          "mood": "happy"
        },
        {
          "type": "avatar_say",
          "clip": "talk_a",
          "text": "I want to know you! Can I ask you some things?",
          "audio": "intro_02.mp3"
        },
        {
          "type": "ask",
          "key": "favorite",
          "clip": "think",
          "text": "What do you love the most?",
          "audio": "intro_03.mp3",
          "options": [
            {
              "id": "dog",
              "label": "Dogs",
              "icon": "dog"
            },
            {
              "id": "cat",
              "label": "Cats",
              "icon": "cat"
            },
            {
              "id": "ice",
              "label": "Ice cream",
              "icon": "ice"
            },
            {
              "id": "ball",
              "label": "Playing ball",
              "icon": "ball"
            },
            {
              "id": "music",
              "label": "Music",
              "icon": "music"
            },
            {
              "id": "rainbow",
              "label": "Rainbows",
              "icon": "rainbow"
            }
          ]
        },
        {
          "type": "avatar_say",
          "clip": "heart",
          "text": "{favorite}! Me too. I love oranges and my bird friend.",
          "audio": "intro_04.mp3",
          "mood": "happy"
        },
        {
          "type": "ask",
          "key": "thankfulFor",
          "clip": "think",
          "text": "What made you happy today?",
          "audio": "intro_05.mp3",
          "options": [
            {
              "id": "family",
              "label": "My family",
              "icon": "family"
            },
            {
              "id": "food",
              "label": "Yummy food",
              "icon": "apple"
            },
            {
              "id": "friends",
              "label": "My friends",
              "icon": "friends"
            },
            {
              "id": "sun",
              "label": "Sunshine",
              "icon": "sun"
            },
            {
              "id": "toys",
              "label": "My toys",
              "icon": "blocks"
            },
            {
              "id": "hugs",
              "label": "Hugs",
              "icon": "heart"
            }
          ]
        },
        {
          "type": "ask",
          "key": "feeling",
          "clip": "listen_nod",
          "text": "How do you feel right now?",
          "audio": "intro_06.mp3",
          "options": [
            {
              "id": "happy",
              "label": "Happy",
              "icon": "happy"
            },
            {
              "id": "calm",
              "label": "Calm",
              "icon": "calm"
            },
            {
              "id": "sleepy",
              "label": "Sleepy",
              "icon": "sleepy"
            },
            {
              "id": "scared",
              "label": "A bit scared",
              "icon": "scared"
            }
          ]
        },
        {
          "type": "avatar_say",
          "clip": "talk_b",
          "text": "Thank you for telling me. Now I'll tell you my secret.",
          "audio": "intro_07.mp3"
        },
        {
          "type": "avatar_say",
          "clip": "talk_a",
          "text": "I talk to God every day. It's called praying. Let's try together!",
          "audio": "intro_08.mp3",
          "mood": "calm"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "first-prayer"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "avatar_say",
          "clip": "celebrate",
          "text": "You did it! Your first lantern is on the pond.",
          "audio": "intro_10.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w1d1",
      "week": "w1",
      "day": 1,
      "skillId": "hello",
      "title": "God Is Always Listening",
      "free": true,
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi {kidName}! I'm Capy. Guess what? God is always listening. Always!",
          "audio": "w1d1_01.mp3",
          "mood": "happy"
        },
        {
          "type": "avatar_say",
          "clip": "talk_a",
          "text": "Talking to God is called praying. It's just like talking to a friend.",
          "audio": "w1d1_02.mp3"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "hello-god-v1"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w1d1_who_listens"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "avatar_say",
          "clip": "celebrate",
          "text": "You just prayed! High five!",
          "audio": "w1d1_05.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w1d2",
      "week": "w1",
      "day": 2,
      "skillId": "hello",
      "title": "You Can Pray Anywhere",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi again, {kidName}! I prayed in the pond today. Splash!",
          "audio": "w1d2_01.mp3",
          "mood": "happy"
        },
        {
          "type": "avatar_say",
          "clip": "think",
          "text": "You can pray anywhere. In bed, in the car, even in the bath.",
          "audio": "w1d2_02.mp3"
        },
        {
          "type": "avatar_say",
          "clip": "talk_b",
          "text": "God hears you everywhere. Let's say hi from right here.",
          "audio": "w1d2_03.mp3"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "hello-god-v1"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w1d2_places"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "avatar_say",
          "clip": "heart",
          "text": "Another lantern for the pond! See you tomorrow.",
          "audio": "w1d2_06.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w1d3",
      "week": "w1",
      "day": 3,
      "skillId": "hello",
      "title": "Meet Your Prayer People",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi {kidName}! Today we pick people to pray for.",
          "audio": "w1d3_01.mp3",
          "mood": "happy"
        },
        {
          "type": "avatar_say",
          "clip": "talk_a",
          "text": "I pray for my bird friend every day. Who do you love?",
          "audio": "w1d3_02.mp3"
        },
        {
          "type": "choose_people",
          "min": 1,
          "max": 3,
          "text": "Tap three people you want to pray for.",
          "audio": "w1d3_03.mp3"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "for-others-v1"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w1d3_people"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "parent_prompt",
          "text": "Ask your child: \"Who did you pray for today?\" Capy will remember these names and ask about them later."
        },
        {
          "type": "avatar_say",
          "clip": "heart",
          "text": "Your prayer people live in the pond now. Bye!",
          "audio": "w1d3_07.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w1d4",
      "week": "w1",
      "day": 4,
      "skillId": "thank-you",
      "title": "Noticing Good Things",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi {kidName}! I found a yummy orange today. Thank you, God!",
          "audio": "w1d4_01.mp3",
          "mood": "happy"
        },
        {
          "type": "avatar_say",
          "clip": "talk_a",
          "text": "Good things are everywhere. Saying thank you is a prayer too.",
          "audio": "w1d4_02.mp3"
        },
        {
          "type": "avatar_say",
          "clip": "think",
          "text": "What made you smile today? Let's tell God three things.",
          "audio": "w1d4_03.mp3"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "thank-you-v1"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w1d4_gratitude_garden"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "avatar_say",
          "clip": "munch",
          "text": "Thank you prayers make my tummy happy. Bye!",
          "audio": "w1d4_06.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w1d5",
      "week": "w1",
      "day": 5,
      "skillId": "thank-you",
      "title": "Thank You Before We Eat",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi {kidName}! Before I munch, I say a little thank you.",
          "audio": "w1d5_01.mp3",
          "mood": "happy"
        },
        {
          "type": "avatar_say",
          "clip": "talk_b",
          "text": "It's called grace. It's short and you can say it every meal.",
          "audio": "w1d5_02.mp3"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "grace-god-is-great"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w1d5_grace_order"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "parent_prompt",
          "text": "Try it tonight: let your child lead grace at the dinner table. Two lines is all it takes."
        },
        {
          "type": "avatar_say",
          "clip": "munch",
          "text": "Now you can say grace at dinner. Munch munch!",
          "audio": "w1d5_06.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w1d6",
      "week": "w1",
      "day": 6,
      "skillId": "thank-you",
      "title": "Thank You for People",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi {kidName}! People are the best gift of all.",
          "audio": "w1d6_01.mp3",
          "mood": "happy"
        },
        {
          "type": "avatar_say",
          "clip": "talk_a",
          "text": "Pick two people you love. We'll thank God for them.",
          "audio": "w1d6_02.mp3"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w1d6_thank_people"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "thank-you-v1"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "avatar_say",
          "clip": "heart",
          "text": "They would love to know you prayed for them.",
          "audio": "w1d6_05.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w1d7",
      "week": "w1",
      "day": 7,
      "skillId": "review",
      "title": "Beacon Day 1",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "celebrate",
          "text": "{kidName}, it's Beacon Day! Seven lanterns light a beacon.",
          "audio": "w1d7_01.mp3",
          "mood": "happy"
        },
        {
          "type": "avatar_say",
          "clip": "talk_a",
          "text": "This week you learned Hello and Thank You. Let's pray both!",
          "audio": "w1d7_02.mp3"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "hello-thanks-review"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w1d7_review"
        },
        {
          "type": "minigame",
          "minigameId": "mg_listen_30"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "avatar_say",
          "clip": "celebrate",
          "text": "The beacon is shining! You earned a flower for me.",
          "audio": "w1d7_06.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w2d1",
      "week": "w2",
      "day": 1,
      "skillId": "thank-you",
      "title": "Thank You for My Body",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi {kidName}! Wiggle your fingers. Blink your eyes. Amazing!",
          "audio": "w2d1_01.mp3",
          "mood": "happy"
        },
        {
          "type": "avatar_say",
          "clip": "talk_a",
          "text": "God made your eyes, ears, nose, hands and tongue. Let's say thanks.",
          "audio": "w2d1_02.mp3"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "thank-you-body",
          "clip": "pray_hands"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w2d1_senses"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "avatar_say",
          "clip": "heart",
          "text": "Your body is a gift. Take good care of it!",
          "audio": "w2d1_05.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w2d2",
      "week": "w2",
      "day": 2,
      "skillId": "thank-you",
      "title": "Even Hard Days",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "sad",
          "text": "Hi {kidName}. Today I dropped my orange in the mud. Yuck.",
          "audio": "w2d2_01.mp3",
          "mood": "sad"
        },
        {
          "type": "avatar_say",
          "clip": "think",
          "text": "But my bird friend shared his seeds. Even hard days have good bits.",
          "audio": "w2d2_02.mp3"
        },
        {
          "type": "avatar_say",
          "clip": "talk_b",
          "text": "When something goes wrong, we can still find one thank you.",
          "audio": "w2d2_03.mp3",
          "mood": "calm"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "thank-you-hard-day",
          "clip": "pray_hands"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w2d2_bad_to_good"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "avatar_say",
          "clip": "heart",
          "text": "See? God is with you on hard days too.",
          "audio": "w2d2_06.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w2d3",
      "week": "w2",
      "day": 3,
      "skillId": "sorry",
      "title": "Everyone Makes Mistakes",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi {kidName}. Can I tell you a secret? I make mistakes too.",
          "audio": "w2d3_01.mp3"
        },
        {
          "type": "avatar_say",
          "clip": "sad",
          "text": "Yesterday I splashed my friend and he got cold. I felt bad.",
          "audio": "w2d3_02.mp3",
          "mood": "sad"
        },
        {
          "type": "avatar_say",
          "clip": "talk_a",
          "text": "Everybody makes mistakes. Saying sorry is how we fix them.",
          "audio": "w2d3_03.mp3",
          "mood": "calm"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "sorry-v1",
          "clip": "pray_hands"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w2d3_after_mistake"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "avatar_say",
          "clip": "heart",
          "text": "God is glad when we say sorry. Well done.",
          "audio": "w2d3_06.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w2d4",
      "week": "w2",
      "day": 4,
      "skillId": "sorry",
      "title": "God Forgives",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi {kidName}! Remember my splashing mistake? Guess what happened.",
          "audio": "w2d4_01.mp3",
          "mood": "happy"
        },
        {
          "type": "avatar_say",
          "clip": "talk_b",
          "text": "I said sorry to God. And God forgave me. Right away!",
          "audio": "w2d4_02.mp3"
        },
        {
          "type": "avatar_say",
          "clip": "talk_a",
          "text": "Forgive means: it's okay, let's try again. God always forgives.",
          "audio": "w2d4_03.mp3",
          "mood": "calm"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "sorry-v1",
          "clip": "pray_hands"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w2d4_sorry_forgiven"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "avatar_say",
          "clip": "celebrate",
          "text": "Sorry, forgiven, try again. You've got it!",
          "audio": "w2d4_06.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w2d5",
      "week": "w2",
      "day": 5,
      "skillId": "sorry",
      "title": "Saying Sorry to People Too",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi {kidName}. I said sorry to God. Then I said sorry to my friend.",
          "audio": "w2d5_01.mp3"
        },
        {
          "type": "avatar_say",
          "clip": "talk_a",
          "text": "Kind words fix things. Sorry. Thank you. I love you.",
          "audio": "w2d5_02.mp3",
          "mood": "calm"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "sorry-v1",
          "clip": "pray_hands"
        },
        {
          "type": "minigame",
          "minigameId": "mg_w2d5_kind_words"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "parent_prompt",
          "text": "Tonight, ask: \"Is there anyone you want to say sorry to?\" Keep it light. The goal is that sorry feels safe, not scary."
        },
        {
          "type": "avatar_say",
          "clip": "heart",
          "text": "Kind words make hearts warm. Goodnight!",
          "audio": "w2d5_06.mp3",
          "mood": "happy"
        }
      ]
    },
    {
      "id": "w2d6",
      "week": "w2",
      "day": 6,
      "skillId": "listen",
      "title": "Quiet Time With God",
      "beats": [
        {
          "type": "avatar_say",
          "clip": "wave_hello",
          "text": "Hi {kidName}. Today we don't talk much. We listen.",
          "audio": "w2d6_01.mp3",
          "mood": "calm"
        },
        {
          "type": "avatar_say",
          "clip": "listen_nod",
          "text": "Capybaras are very good at being still. Let's be still together.",
          "audio": "w2d6_02.mp3",
          "mood": "calm"
        },
        {
          "type": "listen_timer",
          "seconds": 30,
          "text": "Breathe in… breathe out… I'm listening, God.",
          "audio": "w2d6_03.mp3"
        },
        {
          "type": "repeat_after_me",
          "prayerId": "listen-v1",
          "clip": "listen_nod"
        },
        {
          "type": "reward",
          "lantern": 1
        },
        {
          "type": "avatar_say",
          "clip": "heart",
          "text": "That was peaceful. God likes quiet time with you.",
          "audio": "w2d6_05.mp3",
          "mood": "calm"
        }
      ]
    },
    {
      "id": "w2d7",
      "week": "w2",
      "day": 7,
      "skillId": "review",
      "title": "Beacon Day 2",
