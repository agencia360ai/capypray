{
  "name": "capy-prayer",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "doctor": "node tools/doctor.mjs",
    "content:validate": "pnpm --filter @capy/content validate",
    "audio:prepare": "node tools/audio-fetch.mjs packages/content/packs/christian-us-en-v1 && node tools/audio-manifest.mjs",
    "voice:studio": "tsx tools/voicestudio-batch.ts",
    "avatar:build": "bash tools/avatar/build.sh",
    "avatar:preview": "pnpm --filter @capy/avatar-web dev"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "expo": "^57.0.21",
    "react-native": "0.86.3",
    "@expo/metro-runtime": "~57.0.15",
    "react-native-worklets": "0.10.1",
    "react": "19.2.3"
  },
  "pnpm": {
    "overrides": {
      "react-native": "0.86.3",
      "@react-native/metro-config": "0.86.3",
      "@expo/metro-runtime": "~57.0.15",
      "react-native-worklets": "0.10.1"
    }
  }
}
